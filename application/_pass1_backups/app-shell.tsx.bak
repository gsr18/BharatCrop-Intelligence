"use client";

import Link from "next/link";
import { usePathname } from "next/navigation";
import { useApp } from "./app-providers";
import { navItems } from "../lib/i18n";
import type { ThemePreference } from "../lib/preferences";
import type { ReactNode } from "react";
import { useEffect, useMemo, useState } from "react";

function BrandMark() {
  return (
    <svg
      aria-hidden="true"
      className="brand-mark"
      viewBox="0 0 40 40"
      fill="none"
    >
      <path
        d="M7 31.5C10.7 22.7 19.4 12.8 33 8.5c-1.6 12.2-8.8 22.8-20.8 23.2"
        stroke="currentColor"
        strokeWidth="2.2"
        strokeLinecap="round"
      />
      <path
        d="M8 32c5.8-7.3 11.6-11.4 19.1-15"
        stroke="currentColor"
        strokeWidth="1.8"
        strokeLinecap="round"
      />
      <path
        d="M8 32h24"
        stroke="currentColor"
        strokeWidth="1.8"
        strokeLinecap="round"
      />
    </svg>
  );
}

function DesktopNavigation() {
  const pathname = usePathname();
  const { t } = useApp();
  const [moreOpen, setMoreOpen] = useState(false);
  const primaryItems = [
    { href: "/", key: "overview" },
    { href: "/yield", key: "yield" },
    { href: "/crops", key: "crops" },
    { href: "/insights", key: "intelligentSystem" },
    { href: "/research", key: "research" },
    { href: "/assistant", key: "assistant" },
  ] as const;
  const primaryHrefs = new Set<string>(primaryItems.map((item) => item.href));
  const moreItems = navItems.filter((item) => !primaryHrefs.has(item.href));
  return (
    <nav className="glass-nav" aria-label={t("primaryNavigation")}>
      {primaryItems.map((item) => {
        const active = pathname === item.href;
        return (
          <Link
            className="nav-link"
            href={item.href}
            key={item.href}
            aria-current={active ? "page" : undefined}
          >
            {t(item.key)}
          </Link>
        );
      })}
      <div className="nav-more">
        <button
          aria-expanded={moreOpen}
          className="nav-link nav-more-button"
          onClick={() => setMoreOpen((open) => !open)}
          type="button"
        >
          {t("more")} <span aria-hidden="true">⌄</span>
        </button>
        {moreOpen && (
          <div className="nav-more-menu">
            {moreItems.map((item) => (
              <Link
                aria-current={pathname === item.href ? "page" : undefined}
                className="nav-more-link"
                href={item.href}
                key={item.href}
                onClick={() => setMoreOpen(false)}
              >
                {t(item.key)}
              </Link>
            ))}
          </div>
        )}
      </div>
    </nav>
  );
}

function MobileNavigation() {
  const pathname = usePathname();
  const { t } = useApp();
  const [isOpen, setIsOpen] = useState(false);
  return (
    <>
      <button
        className="mobile-menu-button"
        onClick={() => setIsOpen(!isOpen)}
        aria-label={t("toggleMenu")}
        aria-expanded={isOpen}
      >
        <span className="hamburger" />
      </button>
      {isOpen && (
        <nav className="mobile-nav-overlay" aria-label={t("primaryNavigation")}>
          {navItems.map((item) => {
            const active = pathname === item.href;
            return (
              <Link
                className="mobile-nav-link"
                href={item.href}
                key={item.href}
                aria-current={active ? "page" : undefined}
                onClick={() => setIsOpen(false)}
              >
                {t(item.key)}
              </Link>
            );
          })}
        </nav>
      )}
    </>
  );
}

export function AppShell({ children }: { children: ReactNode }) {
  const { language, setLanguage, theme, setTheme, t } = useApp();
  const [searchOpen, setSearchOpen] = useState(false);
  const [searchQuery, setSearchQuery] = useState("");
  const searchableItems = useMemo(
    () => [
      ...navItems.map((item) => ({
        href: item.href,
        label: t(item.key),
        detail:
          item.href === "/model-development"
            ? t("learningGuide")
            : t("moduleDetail"),
      })),
      {
        href: "/model-development#metrics-title",
        label: "MAE, RMSE and R²",
        detail: t("researchTopic"),
      },
      {
        href: "/model-development#selection-title",
        label: "Why HistGradientBoosting?",
        detail: t("researchTopic"),
      },
      {
        href: "/research",
        label: "22-notebook research journey",
        detail: t("researchTopic"),
      },
    ],
    [t],
  );
  const filteredItems = searchableItems.filter((item) =>
    `${item.label} ${item.detail}`
      .toLowerCase()
      .includes(searchQuery.toLowerCase()),
  );

  useEffect(() => {
    const handleKeyDown = (event: KeyboardEvent) => {
      if ((event.ctrlKey || event.metaKey) && event.key.toLowerCase() === "k") {
        event.preventDefault();
        setSearchOpen((open) => !open);
      }
      if (event.key === "Escape") setSearchOpen(false);
    };
    window.addEventListener("keydown", handleKeyDown);
    return () => window.removeEventListener("keydown", handleKeyDown);
  }, []);

  return (
    <div className="app-frame">
      <header className="glass-header">
        <Link
          className="brand"
          href="/"
          aria-label="BharatCrop Intelligence home"
        >
          <BrandMark />
          <span className="brand-copy">
            <strong>BharatCrop</strong>
            <span>Intelligence</span>
          </span>
        </Link>
        <DesktopNavigation />
        <div className="header-actions">
          <button
            aria-label={`${t("searchPlaceholder")} (Ctrl+K)`}
            className="search-trigger"
            onClick={() => setSearchOpen(true)}
            type="button"
          >
            <span aria-hidden="true">⌕</span>
            <span className="search-trigger-label">{t("search")}</span>
            <kbd>⌘ K</kbd>
          </button>
          <label className="sr-only" htmlFor="language-select">
            {t("language")}
          </label>
          <select
            id="language-select"
            className="glass-select"
            value={language}
            onChange={(event) => setLanguage(event.target.value as "en" | "hi")}
            aria-label={t("language")}
          >
            <option value="en">EN</option>
            <option value="hi">हि</option>
          </select>
          <label className="sr-only" htmlFor="theme-select">
            {t("theme")}
          </label>
          <select
            id="theme-select"
            className="glass-select"
            value={theme}
            onChange={(event) =>
              setTheme(event.target.value as ThemePreference)
            }
            aria-label={t("theme")}
          >
            <option value="system">{t("system")}</option>
            <option value="light">{t("light")}</option>
            <option value="dark">{t("dark")}</option>
          </select>
          <MobileNavigation />
        </div>
      </header>
      <main className="page-content">
        {children}
        <footer className="app-footer">
          <Link className="footer-brand" href="/">
            BharatCrop <span>Intelligence</span>
          </Link>
          <nav aria-label="Footer navigation">
            <Link href="/research">{t("research")}</Link>
            <Link href="/model-development">{t("modelDevelopment")}</Link>
            <Link href="/yield">{t("yield")}</Link>
          </nav>
          <p>Research-led agricultural information · India</p>
        </footer>
      </main>
      {searchOpen && (
        <div
          className="command-overlay"
          onMouseDown={(event) => {
            if (event.target === event.currentTarget) setSearchOpen(false);
          }}
        >
          <section
            aria-label={t("searchPlaceholder")}
            aria-modal="true"
            className="command-dialog"
            role="dialog"
          >
            <div className="command-input-row">
              <span aria-hidden="true">⌕</span>
              <input
                autoFocus
                onChange={(event) => setSearchQuery(event.target.value)}
                placeholder={t("searchPlaceholder")}
                value={searchQuery}
              />
              <button onClick={() => setSearchOpen(false)} type="button">
                Esc
              </button>
            </div>
            <p className="command-caption">{t("searchCaption")}</p>
            <div className="command-results">
              {filteredItems.length ? (
                filteredItems.map((item) => (
                  <Link
                    href={item.href}
                    key={`${item.href}-${item.label}`}
                    onClick={() => {
                      setSearchOpen(false);
                      setSearchQuery("");
                    }}
                  >
                    <span>{item.label}</span>
                    <small>{item.detail}</small>
                    <span aria-hidden="true">↗</span>
                  </Link>
                ))
              ) : (
                <p className="command-empty">{t("searchEmpty")}</p>
              )}
            </div>
          </section>
        </div>
      )}
    </div>
  );
}
