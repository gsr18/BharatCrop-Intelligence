{
  "name": "bharatcrop-frontend",
  "version": "0.1.0",
  "private": true,
  "packageManager": "pnpm@10.15.1",
  "engines": {
    "node": ">=22.12 <23"
  },
  "scripts": {
    "dev": "next dev --hostname 127.0.0.1",
    "build": "next build",
    "lint": "eslint src",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "format:check": "prettier --check src next.config.ts eslint.config.mjs vitest.config.mts tsconfig.json package.json prettier.config.mjs"
  },
  "dependencies": {
    "next": "16.4.3",
    "react": "19.3.1",
    "react-dom": "19.3.1"
  },
  "devDependencies": {
    "@testing-library/react": "^16.3.3",
    "@types/node": "^22.15.0",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "eslint": "^10.14.0",
    "eslint-config-next": "16.4.3",
    "happy-dom": "^21.0.4",
    "prettier": "^3.6.2",
    "typescript": "~5.9.3",
    "vitest": "^5.0.5"
  }
}
