  "variables": {
    "T2M_MAX": {
      "unit": "C",
      "source_tags": ["MERRA2", "POWER"]
    },
    "T2M_MIN": {
      "unit": "C",
      "source_tags": ["MERRA2", "POWER"]
    },
    "PRECTOTCORR": {
      "unit": "mm/day",
      "source_tags": ["MERRA2"]
    }
  },
  "canonical": {
    "row_key": ["cell_id", "date"],
    "cell_id_rule": "Coordinates sorted ascending by latitude then longitude; IDs are cell_0000 through cell_2519.",
    "date_type": "date32; UTC calendar date, not a local timestamp",
    "value_type": "float64",
    "partition_by": ["year derived from date"],
    "sort_by": ["cell_id", "date"],
    "compression": "zstd",
    "compression_level": 9,
    "row_group_size": 250000,
    "parquet_version": "2.6"
  },
  "features": {
    "prediction_lags_days_before_target": [1, 2, 3, 7, 14, 30],
    "rolling_windows_days": [3, 7, 14, 30],
    "wet_day_threshold_mm_day": 1.0,
    "season_bins": {
      "winter": [1, 2],
      "pre_monsoon": [3, 4, 5],
      "monsoon": [6, 7, 8, 9],
      "post_monsoon": [10, 11, 12]
