{
  "dataset_version": "weather-daily-v1",
  "schema_version": "1.0.0",
  "source_root": "data/raw/weather_regional",
  "source_api": {
    "name": "POWER Daily API",
    "version": "v2.10.1",
    "time_standard": "UTC",
    "fill_value": -999.0
  },
  "years": [2013, 2014, 2015, 2016, 2017, 2018, 2019, 2020, 2021, 2022, 2023, 2024],
  "region_ids": [
    "R001", "R002", "R003", "R004", "R005", "R006", "R007", "R008",
    "R009", "R010", "R011", "R012", "R013", "R014", "R015", "R016",
    "R017", "R018", "R019", "R020", "R021", "R022", "R023", "R024",
    "R025", "R026", "R027", "R028", "R029", "R030", "R031", "R032",
    "R033", "R034", "R035", "R036", "R037", "R038", "R039", "R040",
    "R041", "R042", "R043", "R044", "R045", "R046", "R047", "R048",
    "R049", "R050", "R051", "R052", "R053", "R054", "R055", "R056"
  ],
  "expected_grid": {
    "cell_count": 2520,
    "latitude_count": 56,
    "longitude_count": 45,
    "latitude_min": 7.0,
